# Example Nginx server block for the GECRIS static site.
# Upload the contents of dist/ to /var/www/gecris (built with SITE_URL=https://gecris.example.eu BASE_PATH=/).
server {
    listen 80;
    server_name gecris.example.eu;
    root /var/www/gecris;
    index index.html;

    location / {
        try_files $uri $uri/ $uri/index.html =404;
    }

    error_page 404 /404.html;

    # Long-term caching for fingerprinted build assets
    location /_astro/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    gzip on;
    gzip_types text/css application/javascript image/svg+xml application/xml text/plain;
}
