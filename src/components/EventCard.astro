---
/** Compact card for an upcoming event, with a calendar-style date block. */
import type { CollectionEntry } from 'astro:content';
import { formatDate, url } from '../lib/utils';
import Icon from './Icon.astro';

interface Props {
  event: CollectionEntry<'news'>;
}
const { event } = Astro.props;
const { title, eventDate, eventEndDate, location, date } = event.data;
const when = eventDate ?? date;
const month = when.toLocaleDateString('en-GB', { month: 'short', timeZone: 'UTC' });
const day = when.toLocaleDateString('en-GB', { day: '2-digit', timeZone: 'UTC' });
---

<article class="card card-hover flex gap-4 p-4">
  <div class="flex h-16 w-16 shrink-0 flex-col items-center justify-center rounded-xl bg-leaf-50 text-leaf-800 ring-1 ring-leaf-200">
    <span class="text-xs font-semibold uppercase">{month}</span>
    <span class="text-2xl leading-none font-bold">{day}</span>
  </div>
  <div class="min-w-0">
    <h3 class="text-base leading-snug font-semibold">
      <a href={url(`/news/${event.id}/`)} class="hover:text-brand-600">{title}</a>
    </h3>
    <p class="mt-1 flex items-center gap-1 text-xs text-slate-500">
      <Icon name="Calendar" size={13} />
      {formatDate(when)}{eventEndDate && ` – ${formatDate(eventEndDate)}`}
    </p>
    {
      location && (
        <p class="mt-1 flex items-center gap-1 text-xs text-slate-500">
          <Icon name="MapPin" size={13} /> {location}
        </p>
      )
    }
  </div>
</article>
