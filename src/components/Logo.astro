---
import { project } from '../data/project';
import { url } from '../lib/utils';

interface Props {
  variant?: 'dark' | 'light';
  class?: string;
}
const { variant = 'dark', class: className = '' } = Astro.props;
const text = variant === 'light' ? 'text-white' : 'text-brand-900';
const sub = variant === 'light' ? 'text-leaf-200' : 'text-leaf-700';
---

<span class:list={['inline-flex items-center gap-3', className]}>
  <img
    src={url(project.logo || 'logos/gecris-logo.jpeg')}
    alt={`${project.acronym} logo`}
    class:list={[
      'h-11 w-auto object-contain rounded',
      variant === 'light' && 'bg-white p-1'
    ]}
    loading="eager"
    decoding="async"
  />
  <span class="flex flex-col leading-none">
    <span class:list={['text-xl font-extrabold tracking-wide', text]}>{project.acronym}</span>
    <span class:list={['mt-1 hidden text-[11px] font-medium sm:block', sub]}>{project.title}</span>
  </span>
</span>