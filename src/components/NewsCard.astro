---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate, url } from '../lib/utils';
import Icon from './Icon.astro';

interface Props {
  article: CollectionEntry<'news'>;
  headingLevel?: 'h2' | 'h3';
}
const { article, headingLevel = 'h3' } = Astro.props;
const { title, description, date, image, type, location, eventDate } = article.data;
const href = url(`/news/${article.id}/`);
const Heading = headingLevel;
---

<article class="card card-hover group flex h-full flex-col overflow-hidden">
  <a href={href} class="block aspect-[16/9] overflow-hidden bg-brand-100" tabindex="-1" aria-hidden="true">
    {
      image ? (
        <Image
          src={image}
          alt=""
          widths={[400, 640, 800]}
          sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw"
          class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
        />
      ) : (
        <div class="flex h-full items-center justify-center text-brand-300">
          <Icon name="Newspaper" size={40} />
        </div>
      )
    }
  </a>
  <div class="flex flex-1 flex-col p-6">
    <div class="flex flex-wrap items-center gap-2 text-xs text-slate-500">
      <span class:list={['badge', type === 'event' ? 'bg-leaf-100 text-leaf-800' : 'bg-brand-50 text-brand-700']}>
        {type === 'event' ? 'Event' : 'News'}
      </span>
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
    </div>
    <Heading class="mt-3 text-lg leading-snug font-semibold">
      <a href={href} class="hover:text-brand-600 focus-visible:underline">{title}</a>
    </Heading>
    <p class="mt-2 line-clamp-3 flex-1 text-sm leading-relaxed text-slate-600">{description}</p>
    {
      type === 'event' && (eventDate || location) && (
        <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-slate-500">
          {eventDate && (
            <span class="inline-flex items-center gap-1">
              <Icon name="Calendar" size={13} /> {formatDate(eventDate)}
            </span>
          )}
          {location && (
            <span class="inline-flex items-center gap-1">
              <Icon name="MapPin" size={13} /> {location}
            </span>
          )}
        </p>
      )
    }
    <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-700" aria-hidden="true">
      Read more <Icon name="ArrowRight" size={14} class="transition group-hover:translate-x-0.5" />
    </span>
  </div>
</article>
