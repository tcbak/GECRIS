---
import type { Partner } from '../lib/data';
import { url } from '../lib/utils';
import Icon from './Icon.astro';

interface Props {
  partner: Partner;
}
const { partner } = Astro.props;
const isCoordinator = partner.role === 'Coordinator';
---

<article class="card card-hover flex h-full flex-col overflow-hidden">
  <div class="flex h-36 items-center justify-center border-b border-slate-100 bg-surface p-6">
    <img
      src={url(partner.logo || '/images/partners/partner-placeholder.svg')}
      alt={`${partner.name} logo`}
      width="240"
      height="120"
      loading="lazy"
      decoding="async"
      class="max-h-24 w-auto object-contain"
    />
  </div>
  <div class="flex flex-1 flex-col p-6">
    <div class="flex flex-wrap items-center gap-2">
      {
        partner.role && (
          <span class:list={['badge', isCoordinator ? 'bg-leaf-100 text-leaf-800' : 'bg-brand-50 text-brand-700']}>
            {partner.role}
          </span>
        )
      }
      {partner.placeholder && <span class="badge bg-amber-100 text-amber-900">Placeholder</span>}
    </div>
    <h3 class="mt-3 text-lg font-semibold">{partner.name}</h3>
    <p class="mt-1 flex items-center gap-1.5 text-sm text-slate-500">
      <Icon name="MapPin" size={14} />
      {partner.country}
    </p>
    <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{partner.description}</p>
    {
      partner.website && (
        <a
          href={partner.website}
          target="_blank"
          rel="noopener noreferrer"
          class="link mt-4 inline-flex items-center gap-1.5 text-sm"
        >
          Visit website <Icon name="ExternalLink" size={14} />
          <span class="sr-only">(opens in a new tab)</span>
        </a>
      )
    }
  </div>
</article>
