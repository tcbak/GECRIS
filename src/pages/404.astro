---
import Icon from '../components/Icon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/utils';
---

<BaseLayout title="Page not found" description="The requested page could not be found." noindex>
  <section class="container-page flex flex-col items-center py-24 text-center sm:py-32">
    <p class="font-mono text-6xl font-bold text-leaf-500">404</p>
    <h1 class="mt-4 text-3xl font-bold sm:text-4xl">Page not found</h1>
    <p class="mt-4 max-w-md text-slate-600">
      Sorry, the page you are looking for does not exist or may have been moved.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href={url('/')} class="btn btn-primary"><Icon name="ArrowLeft" size={16} /> Back to home</a>
      <a href={url('/contact')} class="btn btn-outline">Contact us</a>
    </div>
  </section>
</BaseLayout>
