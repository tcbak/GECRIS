---
/** Generates one page per Markdown file in src/content/news/. */
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import FundingAcknowledgement from '../../components/FundingAcknowledgement.astro';
import Icon from '../../components/Icon.astro';
import NewsCard from '../../components/NewsCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNews } from '../../lib/news';
import { formatDate, url } from '../../lib/utils';

export async function getStaticPaths() {
  const news = await getNews();
  return news.map((article) => ({ params: { id: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const { title, description, date, image, imageAlt, type, eventDate, eventEndDate, location, photos, placeholder } = article.data;
const related = (await getNews()).filter((n) => n.id !== article.id).slice(0, 3);
---

<BaseLayout title={title} description={description} type="article" publishedTime={date} image={image?.src}>
  <article>
    <header class="border-b border-slate-200 bg-surface">
      <div class="container-page max-w-4xl py-10 sm:py-14">
        <nav aria-label="Breadcrumb" class="text-xs text-slate-500">
          <a href={url('/')} class="hover:underline">Home</a> /
          <a href={url('/news')} class="hover:underline">News & Events</a> /
          <span aria-current="page" class="text-slate-700">{title}</span>
        </nav>
        <div class="mt-6 flex flex-wrap items-center gap-3 text-sm text-slate-500">
          <span class:list={['badge', type === 'event' ? 'bg-leaf-100 text-leaf-800' : 'bg-brand-50 text-brand-700']}>
            {type === 'event' ? 'Event' : 'News'}
          </span>
          <span>Published <time datetime={date.toISOString()}>{formatDate(date)}</time></span>
          {placeholder && <span class="badge bg-amber-100 text-amber-900">Sample content</span>}
        </div>
        <h1 class="mt-4 text-3xl font-bold sm:text-4xl">{title}</h1>
        <p class="mt-4 text-lg leading-relaxed text-slate-600">{description}</p>

        {
          type === 'event' && (eventDate || location) && (
            <dl class="mt-6 flex flex-wrap gap-6 rounded-xl bg-white p-4 text-sm ring-1 ring-slate-200">
              {eventDate && (
                <div class="flex items-center gap-2">
                  <Icon name="Calendar" size={18} class="text-leaf-600" />
                  <dt class="sr-only">Event date</dt>
                  <dd class="font-medium text-brand-900">
                    {formatDate(eventDate)}
                    {eventEndDate && ` – ${formatDate(eventEndDate)}`}
                  </dd>
                </div>
              )}
              {location && (
                <div class="flex items-center gap-2">
                  <Icon name="MapPin" size={18} class="text-leaf-600" />
                  <dt class="sr-only">Location</dt>
                  <dd class="font-medium text-brand-900">{location}</dd>
                </div>
              )}
            </dl>
          )
        }
      </div>
    </header>

    <div class="container-page max-w-4xl py-10">
      {
        image && (
          <Image
            src={image}
            alt={imageAlt}
            widths={[640, 960, 1280]}
            sizes="(min-width: 896px) 896px, 100vw"
            loading="eager"
            class="mb-10 aspect-[16/9] w-full rounded-2xl object-cover shadow-sm"
          />
        )
      }
      <div class="prose prose-slate prose-headings:text-brand-900 prose-a:text-brand-700 max-w-none">
        <Content />
      </div>

      {
        photos.length > 0 && (
          <section class="mt-12" aria-labelledby="photos-heading">
            <h2 id="photos-heading" class="text-xl font-bold">Photographs</h2>
            <ul class="mt-6 grid gap-4 sm:grid-cols-2">
              {photos.map((p) => (
                <li>
                  <figure>
                    <Image src={p.src} alt={p.alt} widths={[480, 800]} sizes="(min-width: 640px) 50vw, 100vw" class="aspect-[3/2] w-full rounded-xl object-cover" />
                    {p.caption && <figcaption class="mt-2 text-sm text-slate-500">{p.caption}</figcaption>}
                  </figure>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-slate-200 pt-8">
        <a href={url('/news')} class="btn btn-outline"><Icon name="ArrowLeft" size={16} /> Back to news</a>
      </div>
      <div class="mt-8">
        <FundingAcknowledgement variant="compact" />
      </div>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="section bg-surface" aria-labelledby="more-news">
        <div class="container-page">
          <h2 id="more-news" class="text-2xl font-bold">More news</h2>
          <ul class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((a) => <li><NewsCard article={a} /></li>)}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>
